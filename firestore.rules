rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Administrator = konto Google, którego adres e-mail jest ID dokumentu w kolekcji "admins"
    // (dokument zakładasz ręcznie w konsoli Firebase, małymi literami).
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/admins/$(request.auth.token.email));
    }

    // Zalogowany może sprawdzić swój własny dokument (żeby panel wiedział, czy jest adminem).
    // Administrator widzi listę administratorów, dodaje nowych i usuwa innych (siebie nie może usunąć).
    match /admins/{email} {
      allow get: if (request.auth != null && request.auth.token.email == email) || isAdmin();
      allow list: if isAdmin();
      allow create, update: if isAdmin()
        && email == email.lower()
        && email.matches('^[^@ ]+@[^@ ]+[.][^@ ]+$');
      allow delete: if isAdmin() && request.auth.token.email != email;
    }

    // Dane firmy, teksty i zdjęcia strony (hero, o firmie) – publiczne do odczytu.
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Produkty: odwiedzający widzą tylko widoczne, admin widzi wszystkie.
    match /products/{productId} {
      allow read: if resource.data.visible == true || isAdmin();
      allow write: if isAdmin();
    }

    // Zdjęcia produktów i realizacji.
    match /photos/{photoId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Anonimowe liczniki dzienne (odsłony, kliknięcia w telefon i e-mail).
    // Odwiedzający może tylko zwiększyć jeden licznik o 1. Odczyt i usuwanie: tylko admin.
    match /stats/{day} {
      allow read, delete: if isAdmin();
      allow create: if day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.keys().hasOnly(['views', 'calls', 'mails'])
        && request.resource.data.get('views', 0) is int
        && request.resource.data.get('calls', 0) is int
        && request.resource.data.get('mails', 0) is int
        && request.resource.data.get('views', 0) + request.resource.data.get('calls', 0) + request.resource.data.get('mails', 0) == 1;
      allow update: if day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.keys().hasOnly(['views', 'calls', 'mails'])
        && request.resource.data.diff(resource.data).affectedKeys().size() == 1
        && (request.resource.data.get('views', 0) == resource.data.get('views', 0) + 1
         || request.resource.data.get('calls', 0) == resource.data.get('calls', 0) + 1
         || request.resource.data.get('mails', 0) == resource.data.get('mails', 0) + 1);
    }

    // Liczniki produktów (odsłony karty, kliknięcia w telefon z karty produktu).
    match /prodStats/{pid} {
      allow read, delete: if isAdmin();
      allow create: if pid.size() <= 60
        && request.resource.data.keys().hasOnly(['views', 'calls'])
        && request.resource.data.get('views', 0) is int
        && request.resource.data.get('calls', 0) is int
        && request.resource.data.get('views', 0) + request.resource.data.get('calls', 0) == 1;
      allow update: if request.resource.data.keys().hasOnly(['views', 'calls'])
        && request.resource.data.diff(resource.data).affectedKeys().size() == 1
        && (request.resource.data.get('views', 0) == resource.data.get('views', 0) + 1
         || request.resource.data.get('calls', 0) == resource.data.get('calls', 0) + 1);
    }

    // Zapytania z formularza na stronie: każdy może dodać, czytać i zarządzać może tylko admin.
    match /inquiries/{id} {
      allow read, update, delete: if isAdmin();
      allow create: if request.resource.data.keys().hasOnly(['name', 'phone', 'msg', 'items', 't', 'read', 'page'])
        && request.resource.data.phone is string
        && request.resource.data.phone.size() >= 5 && request.resource.data.phone.size() <= 30
        && (!('name' in request.resource.data) || (request.resource.data.name is string && request.resource.data.name.size() <= 80))
        && (!('msg' in request.resource.data) || (request.resource.data.msg is string && request.resource.data.msg.size() <= 1500))
        && (!('page' in request.resource.data) || (request.resource.data.page is string && request.resource.data.page.size() <= 200))
        && (!('items' in request.resource.data) || (request.resource.data.items is list && request.resource.data.items.size() <= 20))
        && request.resource.data.t is number
        && request.resource.data.read == false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
